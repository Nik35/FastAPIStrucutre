# Environment Configuration Example
# Copy this file to .env.dev, .env.uta, or .env.prod and update values

# Application Environment
ENV=dev

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dns_orchestrator
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=dns_orchestrator

# Kafka Configuration
KAFKA_BROKER_URL=localhost:9092
KAFKA_DNS_TOPIC=dns_requests

# Redis/Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_QUEUE=dns_tasks
CELERY_WORKER_LOG_LEVEL=INFO

# API Configuration
API_URL=http://localhost:8000/api/v1/dns/create
API_KEY=your_api_key_here

# SSO Configuration
SSO_ENDPOINT=https://your-sso-provider.com
SSO_CLIENT_ID=your_sso_client_id
SSO_CLIENT_SECRET=your_sso_client_secret

# CSM Configuration (if using external CSM)
CSM_BASE_URL=https://your-csm-provider.com
CSM_API_KEY=your_csm_api_key

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
