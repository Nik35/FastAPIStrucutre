# UTA (User Testing Acceptance) environment variables
DATABASE_URL=postgresql://uta_user:uta_password@postgres/dns_orchestrator_uta
KAFKA_BROKER_URL=kafka:29092
CELERY_BROKER_URL=redis://redis:6379/0
API_URL=http://uta-host:8000/api/v1/dns/create
DB_HOST=postgres
DB_PORT=5432
DB_USER=uta_user
DB_PASSWORD=uta_password
DB_NAME=dns_orchestrator_uta

# CSM Connection Details (Placeholders - Replace with actual values)
CSM_BASE_URL=http://uta-csm.example.com # Example: UTA Vault address
CSM_API_KEY=your_uta_csm_api_key # Example: UTA Vault token or other auth credential